# Copy this file to .env.local and fill it in. .env.local is ignored by git.
# All three values are public (they end up in the built site), so they are not secrets.

# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Free key from https://carto.com/basemaps. Leave empty to use plain OpenStreetMap tiles.
VITE_CARTO_KEY=
